---
import Dashboard from "@/components/Dashboard.astro";
import Main from "@/components/Main.astro";
import Layout from "@/layouts/Layout.astro";

// Check if current date is after June 12, 2025 at 7 AM
const targetDate = new Date("2025-06-12T07:00:00+08:00"); // 7 AM Thailand time
const currentDate = new Date();
const shouldShowDashboard = currentDate >= targetDate;
---

<Layout>
    {shouldShowDashboard ? <Dashboard /> : <Main />}
</Layout>